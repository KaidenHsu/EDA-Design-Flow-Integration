:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
S_0x561c50bfd3d0 .scope module, "tb_reg8" "tb_reg8" 2 7;
 .timescale -9 -12;
v0x561c50c332d0_0 .var "clk", 0 0;
v0x561c50c33390_0 .var "d", 7 0;
v0x561c50c33430_0 .var/i "errors", 31 0;
v0x561c50c334d0_0 .net "q", 7 0, v0x561c50c02660_0;  1 drivers
v0x561c50c33590_0 .var "rst_n", 0 0;
E_0x561c50bcf360 .event posedge, v0x561c50bfc6b0_0;
S_0x561c50bfd560 .scope task, "check_q" "check_q" 2 29, 2 29 0, S_0x561c50bfd3d0;
 .timescale -9 -12;
v0x561c50bf9980_0 .var "expected_q", 7 0;
v0x561c50bf98e0_0 .var "tag", 511 0;
TD_tb_reg8.check_q ;
    %load/vec4 v0x561c50c334d0_0;
    %load/vec4 v0x561c50bf9980_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %vpi_call 2 34 "$display", "[FAIL] %0s time=%0t expected_q=%02h got_q=%02h", v0x561c50bf98e0_0, $time, v0x561c50bf9980_0, v0x561c50c334d0_0 {0 0 0};
    %load/vec4 v0x561c50c33430_0;
    %addi 1, 0, 32;
    %store/vec4 v0x561c50c33430_0, 0, 32;
    %jmp T_0.1;
T_0.0 ;
    %vpi_call 2 38 "$display", "[PASS] %0s time=%0t q=%02h", v0x561c50bf98e0_0, $time, v0x561c50c334d0_0 {0 0 0};
T_0.1 ;
    %end;
S_0x561c50c32ed0 .scope module, "dut" "reg8" 2 16, 3 8 0, S_0x561c50bfd3d0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 8 "d";
    .port_info 3 /OUTPUT 8 "q";
