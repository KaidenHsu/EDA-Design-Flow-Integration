#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib64/ivl/system.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
S_0x560c1d5f96f0 .scope module, "tb_mux2" "tb_mux2" 2 7;
 .timescale -9 -12;
v0x560c1d621730_0 .var "a", 0 0;
v0x560c1d6217f0_0 .var "b", 0 0;
v0x560c1d621890_0 .var/i "errors", 31 0;
v0x560c1d621960_0 .var "sel", 0 0;
v0x560c1d621a30_0 .net "y", 0 0, L_0x560c1d621b20;  1 drivers
S_0x560c1d5f8860 .scope task, "check_case" "check_case" 2 23, 2 23 0, S_0x560c1d5f96f0;
 .timescale -9 -12;
v0x560c1d5f89f0_0 .var/i "case_id", 31 0;
v0x560c1d620ea0_0 .var "exp_a", 0 0;
v0x560c1d620f60_0 .var "exp_b", 0 0;
v0x560c1d621000_0 .var "exp_sel", 0 0;
v0x560c1d6210c0_0 .var "exp_y", 0 0;
TD_tb_mux2.check_case ;
    %load/vec4 v0x560c1d621000_0;
    %store/vec4 v0x560c1d621960_0, 0, 1;
    %load/vec4 v0x560c1d620ea0_0;
    %store/vec4 v0x560c1d621730_0, 0, 1;
    %load/vec4 v0x560c1d620f60_0;
    %store/vec4 v0x560c1d6217f0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x560c1d621a30_0;
    %load/vec4 v0x560c1d6210c0_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %vpi_call 2 36 "$display", "[FAIL] case=%0d sel=%0b a=%0b b=%0b expected_y=%0b got_y=%0b", v0x560c1d5f89f0_0, v0x560c1d621960_0, v0x560c1d621730_0, v0x560c1d6217f0_0, v0x560c1d6210c0_0, v0x560c1d621a30_0 {0 0 0};
    %load/vec4 v0x560c1d621890_0;
    %addi 1, 0, 32;
    %store/vec4 v0x560c1d621890_0, 0, 32;
    %jmp T_0.1;
T_0.0 ;
    %vpi_call 2 40 "$display", "[PASS] case=%0d sel=%0b a=%0b b=%0b y=%0b", v0x560c1d5f89f0_0, v0x560c1d621960_0, v0x560c1d621730_0, v0x560c1d6217f0_0, v0x560c1d621a30_0 {0 0 0};
T_0.1 ;
    %end;
S_0x560c1d6211d0 .scope module, "dut" "mux2" 2 16, 3 8 0, S_0x560c1d5f96f0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "sel";
    .port_info 1 /INPUT 1 "a";
    .port_info 2 /INPUT 1 "b";
    .port_info 3 /OUTPUT 1 "y";
v0x560c1d6213d0_0 .net "a", 0 0, v0x560c1d621730_0;  1 drivers
v0x560c1d621490_0 .net "b", 0 0, v0x560c1d6217f0_0;  1 drivers
v0x560c1d621550_0 .net "sel", 0 0, v0x560c1d621960_0;  1 drivers
v0x560c1d6215f0_0 .net "y", 0 0, L_0x560c1d621b20;  alias, 1 drivers
L_0x560c1d621b20 .functor MUXZ 1, v0x560c1d621730_0, v0x560c1d6217f0_0, v0x560c1d621960_0, C4<>;
    .scope S_0x560c1d5f96f0;
T_1 ;
    %vpi_call 2 47 "$dumpfile", "waves/mux2.vcd" {0 0 0};
    %vpi_call 2 48 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x560c1d5f96f0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x560c1d621890_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d621960_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d621730_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d6217f0_0, 0, 1;
    %delay 1000, 0;
    %vpi_call 2 56 "$display", "============================================================" {0 0 0};
    %vpi_call 2 57 "$display", "Week 2 mux2 functional simulation started" {0 0 0};
    %vpi_call 2 58 "$display", "Expected behavior: sel=0 selects a; sel=1 selects b" {0 0 0};
    %vpi_call 2 59 "$display", "============================================================" {0 0 0};
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x560c1d5f89f0_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d621000_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d620ea0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d620f60_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d6210c0_0, 0, 1;
    %fork TD_tb_mux2.check_case, S_0x560c1d5f8860;
    %join;
    %pushi/vec4 2, 0, 32;
    %store/vec4 v0x560c1d5f89f0_0, 0, 32;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d621000_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d620ea0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d620f60_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d6210c0_0, 0, 1;
    %fork TD_tb_mux2.check_case, S_0x560c1d5f8860;
    %join;
    %pushi/vec4 3, 0, 32;
    %store/vec4 v0x560c1d5f89f0_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d621000_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d620ea0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d620f60_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d6210c0_0, 0, 1;
    %fork TD_tb_mux2.check_case, S_0x560c1d5f8860;
    %join;
    %pushi/vec4 4, 0, 32;
    %store/vec4 v0x560c1d5f89f0_0, 0, 32;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d621000_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x560c1d620ea0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d620f60_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x560c1d6210c0_0, 0, 1;
    %fork TD_tb_mux2.check_case, S_0x560c1d5f8860;
    %join;
    %vpi_call 2 67 "$display", "============================================================" {0 0 0};
    %load/vec4 v0x560c1d621890_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_1.0, 4;
    %vpi_call 2 69 "$display", "[RESULT] MUX2 TEST PASSED" {0 0 0};
    %jmp T_1.1;
T_1.0 ;
    %vpi_call 2 71 "$display", "[RESULT] MUX2 TEST FAILED with %0d error(s)", v0x560c1d621890_0 {0 0 0};
T_1.1 ;
    %vpi_call 2 72 "$display", "============================================================" {0 0 0};
    %delay 2000, 0;
    %vpi_call 2 75 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/tb_mux2.v";
    "rtl/mux2.v";
